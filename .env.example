# =============================================================================
# SUPABASE CONFIGURATION TEMPLATE (.env.example)
# Course: Application Development (CIT-U Computer Studies Department)
# =============================================================================
# Instructions:
# 1. Create a project at https://supabase.com (Region: Southeast Asia - Singapore)
# 2. In Project Settings -> API Keys:
#    - Copy Project URL and paste into SUPABASE_URL
#    - Copy Publishable key (sb_publishable_... or anon key) and paste into SUPABASE_KEY
# 3. Copy this file to .env and fill in your actual credentials.
#
# IMPORTANT: Never commit or paste your secret service_role key!
# =============================================================================

SUPABASE_URL=https://YOUR-REF.supabase.co
SUPABASE_KEY=sb_publishable_your_key_here
